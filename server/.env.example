# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# Include your Vite dev server and your deployed GitHub Pages URL.
CORS_ORIGINS=http://localhost:5173,https://Rounak43.github.io

# ---------------------------------------------------------------------------
# Firebase Admin credentials
# ---------------------------------------------------------------------------
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. That downloads a JSON file. Use EITHER option A or option B.
#
# Option A (recommended for hosting providers): paste the whole JSON file as a
# single-line base64 string. Generate it with:
#   node -e "console.log(Buffer.from(require('fs').readFileSync('serviceAccount.json')).toString('base64'))"
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Option B: the three fields individually. Keep the literal \n sequences in the
# private key and keep the whole value wrapped in double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# Admin allowlist
# ---------------------------------------------------------------------------
# Comma-separated emails allowed to write content. A signed-in Firebase user
# whose email is on this list (or who carries the `admin: true` custom claim)
# passes the requireAdmin middleware.
ADMIN_EMAILS=rounaksharma43@gmail.com
